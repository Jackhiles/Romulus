{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Romulus",
  "mainBinaryName": "romulus",
  "identifier": "io.github.jackhiles.romulus",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Romulus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/romulus/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Game",
    "shortDescription": "Controller-first RomM client for the Steam Deck",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
